{
  "name": "ai-paper-archive",
  "version": "0.1.0",
  "private": true,
  "description": "中文 AI 论文站：每周论文档案库 + 经典论文库 + 结构化论文阅读器",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/generate-rss.ts && tsx scripts/generate-sitemap.ts && next build",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "fetch:volume": "tsx scripts/build-volume.ts",
    "generate:deepdive": "tsx scripts/generate-deepdive.ts",
    "test": "tsx --test src/lib/*.test.ts",
    "preview": "next build && python3 -m http.server 4173 --directory out"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
